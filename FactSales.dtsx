        <SQLTask:SqlTaskData
          SQLTask:Connection="{7304F227-A2CA-4579-A9D1-73777907F74D}"
          SQLTask:SqlStatementSource="&#xA;IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM sysobjects&#xA;&#x9;WHERE id = OBJECT_ID(N'FactSales'))&#xA;BEGIN&#xA;&#x9;DROP TABLE [dbo].[FactSales]&#xA;&#xA;&#x9;CREATE TABLE [dbo].[FactSales](&#xA;&#x9;[sales_sid] [int] IDENTITY(1,1) NOT NULL,&#xA;&#x9;[invoice_no] [int] NOT NULL,&#xA;&#x9;[quantity] [int] NOT NULL,&#xA;&#x9;[price] [money] NOT NULL,&#xA;&#x9;[discount] [money] NOT NULL,&#xA;&#x9;[total_price] [money] NOT NULL,&#xA;&#x9;[cost] [money] NOT NULL,&#xA;&#x9;[profit] [money] NOT NULL,&#xA;&#x9;[employee_sid] [int] NOT NULL,&#xA;&#x9;[customer_sid] [int] NOT NULL,&#xA;&#x9;[product_sid] [int] NOT NULL,&#xA;&#x9;[store_sid] [int] NOT NULL,&#xA;&#x9;[time_sid] [int] NOT NULL,&#xA; CONSTRAINT [PK_FactSales] PRIMARY KEY CLUSTERED &#xA;(&#xA;&#x9;[sales_sid] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]&#xA;) ON [PRIMARY]&#xA;&#xA;ALTER TABLE [dbo].[FactSales]  WITH CHECK ADD  CONSTRAINT [FK_FactSales_DimCustomer] FOREIGN KEY([customer_sid])&#xA;REFERENCES [dbo].[DimCustomer] ([customer_sid])&#xA;&#xA;ALTER TABLE [dbo].[FactSales] CHECK CONSTRAINT [FK_FactSales_DimCustomer]&#xA;&#xA;ALTER TABLE [dbo].[FactSales]  WITH CHECK ADD  CONSTRAINT [FK_FactSales_DimEmployee] FOREIGN KEY([employee_sid])&#xA;REFERENCES [dbo].[DimEmployee] ([employee_sid])&#xA;&#xA;ALTER TABLE [dbo].[FactSales] CHECK CONSTRAINT [FK_FactSales_DimEmployee]&#xA;&#xA;ALTER TABLE [dbo].[FactSales]  WITH CHECK ADD  CONSTRAINT [FK_FactSales_DimProduct] FOREIGN KEY([product_sid])&#xA;REFERENCES [dbo].[DimProduct] ([product_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactSales] CHECK CONSTRAINT [FK_FactSales_DimProduct]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactSales]  WITH CHECK ADD  CONSTRAINT [FK_FactSales_DimStore] FOREIGN KEY([store_sid])&#xA;REFERENCES [dbo].[DimStore] ([store_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactSales] CHECK CONSTRAINT [FK_FactSales_DimStore]&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactSales]  WITH CHECK ADD  CONSTRAINT [FK_FactSales_DimTime] FOREIGN KEY([time_sid])&#xA;REFERENCES [dbo].[DimTime] ([time_sid])&#xA;&#xA;&#xA;ALTER TABLE [dbo].[FactSales] CHECK CONSTRAINT [FK_FactSales_DimTime]&#xA;&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
