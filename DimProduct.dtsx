          SQLTask:SqlStatementSource="IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM INFORMATION_SCHEMA.REFERENTIAL_CONSTRAINTS&#xA;&#x9;WHERE CONSTRAINT_NAME = 'FK_FactSales_DimProduct')&#xA;&#xA;BEGIN&#xA;&#x9;ALTER TABLE [dbo].[FactSales] DROP CONSTRAINT [FK_FactSales_DimProduct]&#xA;END&#xA;&#xA;IF EXISTS&#xA;&#x9;(SELECT *&#xA;&#x9;FROM sysobjects&#xA;&#x9;WHERE id = OBJECT_ID(N'DimProduct'))&#xA;BEGIN&#xA;&#x9;DROP TABLE [dbo].[DimProduct]&#xA;&#xA;&#x9;CREATE TABLE [dbo].[DimProduct](&#xA;&#x9;[product_sid] [int] IDENTITY(1,1) NOT NULL,&#xA;&#x9;[product_id] [int] NOT NULL,&#xA;&#x9;[product_name] [nvarchar](50) NOT NULL,&#xA;&#x9;[product_subcategory] [nvarchar](50) NOT NULL,&#xA;&#x9;[product_category] [nvarchar](50) NOT NULL,&#xA; CONSTRAINT [PK_DimProduct] PRIMARY KEY CLUSTERED &#xA;(&#xA;&#x9;[product_sid] ASC&#xA;)WITH (PAD_INDEX = OFF, STATISTICS_NORECOMPUTE = OFF, IGNORE_DUP_KEY = OFF, ALLOW_ROW_LOCKS = ON, ALLOW_PAGE_LOCKS = ON, OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF) ON [PRIMARY]&#xA;) ON [PRIMARY]&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
